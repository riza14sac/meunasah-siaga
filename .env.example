# Salin menjadi .env.local untuk dijalankan di laptop.
# Di Vercel, isi lewat Settings → Environment Variables (lihat docs/DEPLOY.md).

# Database Turso. Kosongkan keduanya di laptop untuk memakai file data/local.db.
# Contoh URL: libsql://meunasah-siaga-namaakun.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Kunci rahasia yang dikirim ESP32 di header x-api-key.
# Juga dipakai server untuk menandatangani cookie admin.
# Buat nilai acak: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVICE_API_KEY=

# PIN admin untuk aksi ubah/hapus di web. Cukup dimasukkan sekali per perangkat.
ADMIN_PIN=
